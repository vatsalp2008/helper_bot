# Copy to .env (git-ignored) and fill in. Used by the Notion tracker and by Workday applications.

# Notion API token for an internal connection (a bot that sees only the pages you share with it):
#   notion.com: Settings -> Developer tools -> Developer connections -> New connection
#   -> name it "helper" -> keep "API token" -> Create connection -> Configuration tab -> show and copy the token.
# Then share the tracker database with it: open the database -> ... menu -> Connections -> + Add connection -> helper.
NOTION_TOKEN=

# The 32-character ID in your database link: notion.so/<workspace>/<DATABASE_ID>?v=... (Claude can fill this in
# from the link you send).
NOTION_DATABASE_ID=

# The login helper uses on Workday: it signs in to, or creates, each company's Workday account with it.
# Typed only on Workday's own sites; never printed or logged.
WORKDAY_EMAIL=
WORKDAY_PASSWORD=

# The login helper uses on iCIMS: it signs in to, or creates, each company's iCIMS account with it. Some iCIMS
# sites ask for a username as well. Typed only on iCIMS's own sites; never printed or logged.
ICIMS_EMAIL=
ICIMS_PASSWORD=
ICIMS_USERNAME=
