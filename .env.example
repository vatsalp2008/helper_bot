# Copy to .env (git-ignored) and fill in. Used only by the Notion tracker (milestone 6).

# Internal integration token: notion.so/profile/integrations -> New integration -> copy the secret.
# Then open your tracker database in Notion -> ... menu -> Connections -> add the integration.
NOTION_TOKEN=

# The 32-character ID in your database URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=
