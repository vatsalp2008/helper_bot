% helper resume template (Jinja2 version of Vatsal's real resume template).
% Jinja delimiters for this file: variables are \VAR{ ... }, blocks are \BLOCK{ ... }.
% Environment settings: trim_blocks=True, lstrip_blocks=True, autoescape off.
% Custom filters (defined in render.py):
%   tex    : escape LaTeX special characters in plain text
%   bullet : escape, then convert **phrase** into \textbf{phrase}
%   url    : escape only % and # for use inside \href
% Do not change the preamble or the macros below. They define the exact look of the resume.
\documentclass[letterpaper,10.5pt]{article}
\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\usepackage{fontawesome5}
\input{glyphtounicode}
\definecolor{cyan}{RGB}{0,150,200}
\pagestyle{fancy}\fancyhf{}\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}
\addtolength{\oddsidemargin}{-0.5in}\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}\addtolength{\topmargin}{-.5in}\addtolength{\textheight}{1.0in}
\urlstyle{same}\raggedbottom\raggedright\setlength{\tabcolsep}{0in}
\titleformat{\section}{\vspace{-4pt}\scshape\raggedright\large\color{cyan}}{}{0em}{}[\color{cyan}\titlerule \vspace{-5pt}]
\pdfgentounicode=1
\newcommand{\resumeItem}[1]{\item\small{{#1 \vspace{-2pt}}}}
\newcommand{\resumeSubheading}[4]{\vspace{-2pt}\item\begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}\textbf{#1} & #2 \\\textit{\small#3} & \textit{\small #4} \\\end{tabular*}\vspace{-7pt}}
\newcommand{\resumeProjectHeading}[2]{\vspace{-3pt}\item\begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}\small#1 & \small #2 \\\end{tabular*}\vspace{-5pt}}
\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}
\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}
\begin{document}
\begin{center}
    \fontsize{20}{24}\selectfont \textbf{\scshape \VAR{header.name|tex}} \\[4pt]
    \normalsize \VAR{header.location|tex} \\[4pt]
    \small \faPhone*~\VAR{header.phone|tex} \quad $|$ \quad \faEnvelope~\href{mailto:\VAR{header.email|url}}{\VAR{header.email|tex}} \quad $|$ \quad \faLinkedin~\href{\VAR{header.linkedin_url|url}}{\VAR{header.linkedin_label|tex}} \quad $|$ \quad \faGithub~\href{\VAR{header.github_url|url}}{\VAR{header.github_label|tex}} \quad $|$ \quad \faGlobe~\href{\VAR{header.portfolio_url|url}}{Portfolio}
\end{center}
\section{Education}
\resumeSubHeadingListStart
\resumeSubheading{Northeastern University}{Seattle, WA}{Master of Science in Computer Science}{Sept. 2025 -- \VAR{grad_date_display|tex}}
\resumeSubheading{University of Mumbai}{Mumbai, India}{Bachelor of Engineering in Computer Engineering}{Oct. 2021 -- May 2025}
\resumeSubHeadingListEnd
\section{Technical Skills}
\begin{itemize}[leftmargin=0.15in, label={}]
\small{\item{\BLOCK{for line in skills_lines}\textbf{\VAR{line.label|tex}}{: \VAR{line.items|join(', ')|tex}}\BLOCK{if not loop.last} \\\BLOCK{endif}\BLOCK{endfor}}}
\end{itemize}
\section{Experience}
\resumeSubHeadingListStart
\BLOCK{for e in experience}
\resumeSubheading{\VAR{e.title|tex}}{\VAR{e.dates|tex}}{\VAR{e.org|tex}}{\VAR{e.location|tex}}
\resumeItemListStart
\BLOCK{for b in e.bullets}
\resumeItem{\VAR{b|bullet}}
\BLOCK{endfor}
\resumeItemListEnd
\BLOCK{endfor}
\resumeSubHeadingListEnd
\section{Projects}
\resumeSubHeadingListStart
\BLOCK{for p in projects}
\resumeProjectHeading{\href{\VAR{p.url|url}}{\textbf{\VAR{p.title|tex}} \faIcon{external-link-alt}} $|$ \emph{\VAR{p.tech_tags|join(', ')|tex}}}{\VAR{p.dates|tex}}
\resumeItemListStart
\BLOCK{for b in p.bullets}
\resumeItem{\VAR{b|bullet}}
\BLOCK{endfor}
\resumeItemListEnd
\BLOCK{endfor}
\resumeSubHeadingListEnd
\section{Relevant Coursework}
\begin{itemize}[leftmargin=0.15in, label={}]
\small{\item{\BLOCK{for c in coursework}\VAR{c|tex}\BLOCK{if not loop.last} $|$ \BLOCK{endif}\BLOCK{endfor}}}
\end{itemize}\vspace{-10pt}
\end{document}
